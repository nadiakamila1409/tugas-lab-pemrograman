
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>KOSPACE — Manage Your Boarding House Smarter</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--p:#192B24;--s:#294235;--soft:#DDE9DF;--bg:#F7F7F4;--w:#fff;--t:#202923;--m:#78827B;--b:#E6EAE6;--ok:#43805A;--wa:#C48A3C;--da:#C65C55}
*{box-sizing:border-box}html,body{margin:0;overflow-x:hidden}body{background:var(--bg);color:var(--t);font:14px/1.5 'Plus Jakarta Sans',Inter,system-ui,sans-serif}
button,input,select,textarea{font:inherit;color:inherit}button{cursor:pointer}:focus-visible{outline:2px solid var(--ok);outline-offset:2px}
aside{position:fixed;inset:0 auto 0 0;width:232px;background:var(--p);color:#cfdad2;padding:20px 12px;display:flex;flex-direction:column;z-index:30;transition:transform .2s}
.logo{display:flex;align-items:center;gap:10px;color:#fff;font-weight:700;font-size:18px;letter-spacing:.5px;padding:0 10px 22px}.logo i{width:30px;height:30px;border-radius:8px;background:var(--soft);color:var(--p);display:grid;place-items:center;font-style:normal;font-size:15px}
nav button{display:block;width:100%;text-align:left;border:0;background:none;color:#b9c8bd;padding:9px 12px;border-radius:8px;margin-bottom:2px}nav button:hover{background:#243a2f;color:#fff}nav button.on{background:var(--s);color:#fff;font-weight:600}
.side-f{margin-top:auto;padding:12px 10px 0;border-top:1px solid #2f4539;font-size:12px}.side-f b{color:#fff;display:block}
main{margin-left:232px}.top{position:sticky;top:0;z-index:20;height:64px;background:rgba(255,255,255,.92);backdrop-filter:blur(6px);border-bottom:1px solid var(--b);display:flex;align-items:center;gap:14px;padding:0 28px}
.top h2{margin:0;font-size:16px;white-space:nowrap}.top .sp{flex:1}.srch{width:min(260px,38vw);padding:8px 12px;border:1px solid var(--b);border-radius:9px;background:var(--bg)}
.ib{width:36px;height:36px;border:1px solid var(--b);background:#fff;border-radius:9px;position:relative}.ib em{position:absolute;top:-4px;right:-4px;background:var(--da);color:#fff;font-size:10px;font-style:normal;min-width:16px;height:16px;border-radius:8px;display:grid;place-items:center}
.av{width:34px;height:34px;border-radius:50%;background:var(--soft);color:var(--p);display:grid;place-items:center;font-weight:700;font-size:12px}.menu{display:none}
#np{position:absolute;right:70px;top:58px;width:290px;background:#fff;border:1px solid var(--b);border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,.12);padding:14px;display:none}#np.on{display:block}#np p{margin:0 0 9px;font-size:13px}
#view{padding:26px 28px 60px;max-width:1400px;margin:auto}.hd{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:20px}.hd h1{margin:0;font-size:22px;letter-spacing:-.4px}.hd p{margin:2px 0 0;color:var(--m)}.hd .ac{display:flex;gap:8px;flex-wrap:wrap}
.btn{border:1px solid var(--b);background:#fff;padding:8px 13px;border-radius:9px;font-weight:600;font-size:13px}.btn:hover{background:var(--bg)}.btn.pr{background:var(--p);border-color:var(--p);color:#fff}.btn.pr:hover{background:var(--s)}.btn.dn{color:var(--da)}.btn.sm{padding:4px 9px;font-size:12px}
.grid{display:grid;gap:14px}.g4{grid-template-columns:repeat(auto-fit,minmax(190px,1fr))}.g2{grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);margin-top:14px}.g3{grid-template-columns:repeat(auto-fill,minmax(235px,1fr))}
.card{background:#fff;border:1px solid var(--b);border-radius:12px;padding:18px}.card h3{margin:0 0 14px;font-size:14px}.stat small{color:var(--m)}.stat b{display:block;font-size:24px;letter-spacing:-.5px;margin-top:6px}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:560px}th{text-align:left;color:var(--m);font-weight:500;font-size:12px;padding:9px 10px;border-bottom:1px solid var(--b)}td{padding:11px 10px;border-bottom:1px solid #f0f2ef;vertical-align:middle}tr:last-child td{border:0}td .ac{display:flex;gap:5px;flex-wrap:wrap}
.bd{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap}.ok{background:#e3efe7;color:#2f6b45}.warn{background:#f8ecd6;color:#8f6220}.red{background:#f6e2e0;color:#a2423b}.mute{background:#eef0ed;color:#68716b}
.bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}.bar select,.bar input{padding:8px 11px;border:1px solid var(--b);border-radius:9px;background:#fff}
.sub{color:var(--m);font-size:12px}.neg{color:var(--da)}.pos{color:var(--ok)}.empty{padding:28px;text-align:center;color:var(--m)}
.room b.n{font-size:17px}.room .rw{display:flex;justify-content:space-between;align-items:center}.room p{margin:6px 0;color:var(--m);font-size:12px}.room .ac{display:flex;gap:6px;margin-top:12px}
.lg{display:flex;gap:14px;font-size:12px;color:var(--m);margin-bottom:6px}.lg i{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:5px}
.dn-w{display:flex;align-items:center;gap:20px;flex-wrap:wrap}.dn-w ul{list-style:none;margin:0;padding:0;flex:1;min-width:130px}.dn-w li{display:flex;justify-content:space-between;padding:4px 0;font-size:13px}
.act{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid #f0f2ef;font-size:13px}.act:last-child{border:0}.act i{width:8px;height:8px;border-radius:50%;background:var(--ok);margin-top:7px;flex:none}
#ov{position:fixed;inset:0;background:rgba(20,30,24,.45);display:none;align-items:center;justify-content:center;padding:14px;z-index:50}#ov.on{display:flex}
#md{background:#fff;border-radius:14px;width:min(560px,100%);max-height:92vh;overflow:auto;padding:22px}#md h3{margin:0 0 16px;font-size:17px}
.fg{display:grid;grid-template-columns:1fr 1fr;gap:12px}.fd{display:flex;flex-direction:column;gap:5px}.fd.full{grid-column:1/-1}.fd label{font-size:12px;color:var(--m)}.fd input,.fd select,.fd textarea{padding:9px 11px;border:1px solid var(--b);border-radius:9px;background:#fff;width:100%}
.er{color:var(--da);font-size:12px;margin-top:10px;min-height:16px}.mf{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.dl{display:grid;grid-template-columns:130px 1fr;gap:6px 10px;font-size:13px}.dl dt{color:var(--m)}.dl dd{margin:0}
#toast{position:fixed;right:20px;bottom:20px;background:var(--p);color:#fff;padding:11px 16px;border-radius:10px;font-size:13px;z-index:80;opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none;max-width:calc(100% - 40px)}#toast.on{opacity:1;transform:none}#toast.err{background:var(--da)}
.scrim{display:none}
@media(max-width:900px){aside{transform:translateX(-100%)}aside.on{transform:none}.scrim.on{display:block;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:25}main{margin-left:0}.menu{display:block}.g2{grid-template-columns:1fr}.top,#view{padding-left:16px;padding-right:16px}#np{right:12px}}
@media(max-width:560px){.fg{grid-template-columns:1fr}.top h2{font-size:14px}.dl{grid-template-columns:100px 1fr}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<aside id="sb"><div class="logo"><i>K</i>KOSPACE</div><nav id="nav"></nav><div class="side-f"><b id="sk"></b><span id="sl"></span></div></aside>
<div class="scrim" id="sc"></div>
<main>
<header class="top"><button class="ib menu" id="mn" aria-label="Buka menu">☰</button><h2 id="pt"></h2><span class="sp"></span><input class="srch" id="q" type="search" placeholder="Cari…" aria-label="Pencarian"><button class="ib" id="bell" aria-label="Notifikasi">🔔<em id="bc"></em></button><div class="av" id="ua"></div><div id="np"></div></header>
<div id="view"></div>
</main>
<div id="ov"><div id="md" role="dialog" aria-modal="true"></div></div>
<div id="toast" role="status"></div>
<script>
const K='kospace_v1',$=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const rp=n=>'Rp'+Math.round(n||0).toLocaleString('id-ID'),pad=n=>String(n).padStart(2,'0'),iso=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
const T=iso(new Date()),MN=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'],uid=()=>Math.random().toString(36).slice(2,9);
const fd=s=>{if(!s)return'—';const[y,m,d]=s.split('-');return+d+' '+MN[m-1]+' '+y},per=p=>MN[p.slice(5)-1]+' '+p.slice(0,4);
const addDays=(s,n)=>{const d=new Date(s+'T00:00:00');d.setDate(d.getDate()+n);return iso(d)};
const PAGES=[['dash','Dashboard'],['rooms','Data Kamar'],['tenants','Penghuni'],['bills','Tagihan'],['fin','Keuangan'],['maint','Maintenance'],['set','Pengaturan']];
const EC=['Listrik','Air','Internet','Perbaikan','Kebersihan','Pengeluaran lainnya'],IC=['Uang sewa','Biaya tambahan','Pemasukan lainnya'];
let D,S={page:'dash',q:'',f:{rooms:'',tenants:'',bills:'',maint:'',from:'',to:'',cat:''}};

function seed(){
 const now=new Date(),ym=k=>{const d=new Date(now.getFullYear(),now.getMonth()-k,1);return d.getFullYear()+'-'+pad(d.getMonth()+1)};
 const pr=[800,850,900,950,1000,1100,1200,1250,1400,1500],rooms=[],tenants=[],bills=[],tx=[],maint=[];
 for(let f=1;f<=2;f++)for(let i=1;i<=10;i++){const no=f*100+i,p=pr[(i-1+(f-1)*3)%10]*1000;rooms.push({id:'r'+no,no:String(no),prop:'Kos Tembalang',floor:f,price:p,fac:p>=1100000?'AC, Kamar mandi dalam, Kasur, Lemari':p>=950000?'Kipas, Kamar mandi dalam, Kasur':'Kipas, Kamar mandi luar, Kasur',manual:false})}
 const names=['Aditya Pratama','Siti Nurhaliza','Rizky Ramadhan','Dewi Anggraini','Bagas Saputra','Nadia Putri','Fajar Nugroho','Maya Kusuma','Yoga Prasetyo','Intan Permata','Dimas Wicaksono','Rina Safitri','Kevin Hartono','Eko Setiawan'],rn=[101,102,103,104,105,106,107,109,201,202,203,205,207,110];
 names.forEach((n,i)=>{const r=rooms.find(r=>r.no==rn[i]),out=i==13,sk=5-(i%6),ok=out?2:0,id='t'+i;
  tenants.push({id,name:n,phone:'0812'+(3400000+i*17231),email:n.split(' ')[0].toLowerCase()+'@mail.com',roomId:r.id,in:ym(sk)+'-01',out:out?ym(2)+'-25':'',price:r.price,deposit:r.price,status:out?'Keluar':'Aktif'});
  for(let k=sk;k>=ok;k--){const p=ym(k),b={id:uid(),tenantId:id,period:p,date:p+'-01',due:k==0&&p+'-10'<T?addDays(T,7):p+'-10',amount:r.price,pays:[]};let pay=1;
   if(k==0)pay=[1,.5,0,1][i%4];if(k==1&&i==5)pay=0;if(k==1&&i==9)pay=.5;
   if(pay){let d=p+'-'+pad(3+i%6);if(d>T)d=T;const a=r.price*pay,py={id:uid(),date:d,amount:a,method:['Transfer','Tunai','QRIS'][i%3]};b.pays.push(py);tx.push({id:uid(),type:'in',cat:'Uang sewa',date:d,amount:a,desc:'Sewa '+n+' (kamar '+r.no+')',pid:py.id})}
   bills.push(b)}});
 for(let k=5;k>=0;k--){const d=ym(k)+'-'+(k?'15':pad(Math.min(15,now.getDate())));
  [['Listrik',1050000+k*40000],['Air',320000],['Internet',350000],['Kebersihan',250000]].forEach(([c,a])=>tx.push({id:uid(),type:'out',cat:c,date:d,amount:a,desc:c+' bulanan'}))}
 tx.push({id:uid(),type:'in',cat:'Biaya tambahan',date:ym(1)+'-20',amount:150000,desc:'Biaya laundry kamar 104'});
 maint.push({id:'m1',title:'AC tidak dingin',roomId:'r108',desc:'Freon habis, menunggu teknisi.',date:ym(0)+'-02',cost:350000,status:'Diproses',flag:true},
  {id:'m2',title:'Keran bocor',roomId:'r102',desc:'Keran kamar mandi menetes.',date:ym(1)+'-12',cost:150000,status:'Selesai',flag:false,done:ym(1)+'-13'},
  {id:'m3',title:'Lampu koridor mati',roomId:'r205',desc:'Lampu depan kamar 205.',date:T,cost:0,status:'Baru',flag:false});
 tx.push({id:uid(),type:'out',cat:'Perbaikan',date:ym(1)+'-13',amount:150000,desc:'Keran bocor (kamar 102)',mid:'m2'});
 const h=36e5,log=[{t:Date.now()-2*h,x:'Pembayaran sewa diterima dari Aditya Pratama'},{t:Date.now()-20*h,x:'Laporan baru: Lampu koridor mati (kamar 205)'},{t:Date.now()-50*h,x:'AC kamar 108 mulai diperbaiki'},{t:Date.now()-90*h,x:'Tagihan bulanan dibuat untuk semua penghuni'}];
 return{cfg:{name:'Kos Tembalang',loc:'Tembalang, Semarang',owner:'Lia'},rooms,tenants,bills,tx,maint,log}}
function load(){try{const s=localStorage.getItem(K);if(s)return JSON.parse(s)}catch(e){}return null}
function save(){try{localStorage.setItem(K,JSON.stringify(D))}catch(e){}}
D=load()||seed();save();

// ---- derived
const room=id=>D.rooms.find(r=>r.id===id),rno=id=>room(id)?.no||'—',ten=id=>D.tenants.find(t=>t.id===id);
const occ=id=>D.tenants.find(t=>t.roomId===id&&t.status==='Aktif'),isM=r=>r.manual||D.maint.some(m=>m.roomId===r.id&&m.flag&&m.status!=='Selesai');
const rst=r=>isM(r)?'Maintenance':occ(r.id)?'Terisi':'Kosong';
const paid=b=>b.pays.reduce((a,p)=>a+p.amount,0),bst=b=>{const p=paid(b);return p>=b.amount?'Lunas':b.due<T?'Terlambat':p>0?'Dibayar sebagian':'Belum dibayar'};
const sum=(ty,ym,l=D.tx)=>l.filter(t=>t.type===ty&&(!ym||t.date.startsWith(ym))).reduce((a,t)=>a+t.amount,0);
const bcls=s=>({Terisi:'ok',Lunas:'ok',Selesai:'ok',Aktif:'ok',Maintenance:'warn','Dibayar sebagian':'warn',Diproses:'warn',Terlambat:'red'}[s]||'mute'),badge=s=>`<span class="bd ${bcls(s)}">${s}</span>`;
const log=x=>{D.log.unshift({t:Date.now(),x});D.log=D.log.slice(0,30)},has=(s,q)=>s.toLowerCase().includes(q.toLowerCase());
function ago(t){const m=Math.round((Date.now()-t)/6e4);return m<1?'Baru saja':m<60?m+' menit lalu':m<1440?Math.round(m/60)+' jam lalu':Math.round(m/1440)+' hari lalu'}

// ---- ui helpers
let tt;function toast(m,err){const e=$('#toast');e.textContent=m;e.className='on'+(err?' err':'');clearTimeout(tt);tt=setTimeout(()=>e.className='',2800)}
const openM=h=>{$('#md').innerHTML=h;$('#ov').classList.add('on')},closeM=()=>$('#ov').classList.remove('on');
function field([k,l,t,o,c,opt],v){const val=v??'';let i;
 if(t==='select')i=`<select name="${k}">${(o||[]).map(x=>{const[a,b]=Array.isArray(x)?x:[x,x];return`<option value="${esc(a)}"${String(a)===String(val)?' selected':''}>${esc(b)}</option>`}).join('')}</select>`;
 else if(t==='textarea')i=`<textarea name="${k}" rows="3">${esc(val)}</textarea>`;
 else i=`<input name="${k}" type="${t}" value="${esc(val)}"${t==='number'?' min="0" step="any"':''}>`;
 return`<div class="fd ${c||''}"><label>${l}${opt?' (opsional)':''}</label>${i}</div>`}
function form(title,fields,vals,onSave,okLabel){
 openM(`<h3>${title}</h3><form novalidate><div class="fg">${fields.map(f=>field(f,vals[f[0]])).join('')}</div><div class="er" id="er"></div><div class="mf"><button type="button" class="btn" data-a="close">Batal</button><button class="btn pr">${okLabel||'Simpan'}</button></div></form>`);
 $('#md form').onsubmit=e=>{e.preventDefault();const fdt=new FormData(e.target),v={};let err='';
  for(const[k,l,t,o,c,opt]of fields){let x=String(fdt.get(k)??'').trim();if(!x&&!opt){err=l+' wajib diisi.';break}
   if(t==='number'){x=x===''?0:Number(x);if(isNaN(x)||x<0){err=l+' harus berupa angka positif.';break}}v[k]=x}
  err=err||onSave(v)||'';if(err){$('#er').textContent=err;toast(err,1)}else{save();closeM();render()}}}
function ask(msg,fn){openM(`<h3>Konfirmasi</h3><p>${msg}</p><div class="mf"><button class="btn" data-a="close">Batal</button><button class="btn pr" id="yes">Ya, lanjutkan</button></div>`);$('#yes').onclick=()=>{fn();save();closeM();render()}}
const head=(t,s,a)=>`<div class="hd"><div><h1>${t}</h1><p>${s}</p></div><div class="ac">${a||''}</div></div>`;
const tbl=(h,rows,em)=>rows.length?`<div class="card tw" style="padding:6px 8px"><table><thead><tr>${h.map(x=>`<th>${x}</th>`).join('')}</tr></thead><tbody>${rows.join('')}</tbody></table></div>`:`<div class="card empty">${em}</div>`;
const btn=(a,id,l,c='')=>`<button class="btn sm ${c}" data-a="${a}" data-id="${id}">${l}</button>`;
const sel=(key,opts,all)=>`<select aria-label="Filter" onchange="S.f['${key}']=this.value;render()"><option value="">${all}</option>${opts.map(o=>{const[a,b]=Array.isArray(o)?o:[o,o];return`<option value="${esc(a)}"${S.f[key]===a?' selected':''}>${esc(b)}</option>`}).join('')}</select>`;

// ---- charts
function months(){const a=[],n=new Date();for(let k=5;k>=0;k--){const d=new Date(n.getFullYear(),n.getMonth()-k,1);a.push(d.getFullYear()+'-'+pad(d.getMonth()+1))}return a}
function chart(){const ms=months(),I=ms.map(m=>sum('in',m)),O=ms.map(m=>sum('out',m)),mx=Math.max(1e6,...I,...O)*1.1;
 let s=`<div class="lg"><span><i style="background:#294235"></i>Pemasukan</span><span><i style="background:#C48A3C"></i>Pengeluaran</span></div><svg viewBox="0 0 600 230" width="100%" role="img" aria-label="Grafik pemasukan dan pengeluaran 6 bulan terakhir">`;
 [0,.5,1].forEach(g=>{const y=190-g*170;s+=`<line x1="44" x2="600" y1="${y}" y2="${y}" stroke="#E6EAE6"/><text x="38" y="${y+4}" text-anchor="end" font-size="10" fill="#78827B">${(mx*g/1e6).toFixed(1)} jt</text>`});
 ms.forEach((m,i)=>{const x=66+i*89,h1=I[i]/mx*170,h2=O[i]/mx*170;s+=`<rect x="${x}" y="${190-h1}" width="28" height="${h1}" rx="3" fill="#294235"><title>Pemasukan ${rp(I[i])}</title></rect><rect x="${x+32}" y="${190-h2}" width="28" height="${h2}" rx="3" fill="#C48A3C"><title>Pengeluaran ${rp(O[i])}</title></rect><text x="${x+30}" y="210" text-anchor="middle" font-size="11" fill="#78827B">${MN[m.slice(5)-1]}</text>`});
 return s+'</svg>'}
function donut(){const c={Terisi:0,Kosong:0,Maintenance:0},col={Terisi:'#294235',Kosong:'#DDE9DF',Maintenance:'#C48A3C'};D.rooms.forEach(r=>c[rst(r)]++);const n=D.rooms.length||1,C=2*Math.PI*48;let off=0,s='';
 for(const k in c){const l=c[k]/n*C;s+=`<circle r="48" cx="60" cy="60" fill="none" stroke="${col[k]}" stroke-width="16" stroke-dasharray="${l} ${C-l}" stroke-dashoffset="${-off}" transform="rotate(-90 60 60)"/>`;off+=l}
 return`<div class="dn-w"><svg viewBox="0 0 120 120" width="130" height="130" role="img" aria-label="Status kamar">${s}<text x="60" y="58" text-anchor="middle" font-size="20" font-weight="700" fill="#202923">${c.Terisi}/${D.rooms.length}</text><text x="60" y="73" text-anchor="middle" font-size="9" fill="#78827B">terisi</text></svg><ul>${Object.keys(c).map(k=>`<li><span><i style="display:inline-block;width:9px;height:9px;border-radius:3px;background:${col[k]};margin-right:8px"></i>${k}</span><b>${c[k]}</b></li>`).join('')}</ul></div>`}

// ---- pages
const P={};
P.dash=()=>{const ym=T.slice(0,7),c={};D.rooms.forEach(r=>{const s=rst(r);c[s]=(c[s]||0)+1});
 const ub=D.bills.filter(b=>bst(b)!=='Lunas').sort((a,b)=>a.due.localeCompare(b.due)),st=(l,v,s)=>`<div class="card stat"><small>${l}</small><b>${v}</b><span class="sub">${s}</span></div>`;
